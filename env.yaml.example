Server:
  Port: 8201
  Port2: 8202
# Optional: MCP stdio (`prof … mcp`). With `-c` this file: if APIBase empty, uses http://127.0.0.1:{Server.Port}. Without `-c`, MCP ignores YAML and uses flag -port (default 8201) or env PROF_API_BASE.
Mcp:
  APIBase: ""
App:
  # env: prod|local
  Env: prod
  Log: ./logs
Data:
  StorageDir: ./storage